        "def test_f_h_eta_consistency():\n",
        "    \"\"\"\n",
        "    Test F, H, and η_n mathematical consistency for mapping.\n",
        "    \"\"\"\n",
        "    obstacles, area = load_obstacles_config(environment='toy2')\n",
        "    motion_model = DoubleIntegratorModel(p_x=5.0, p_y=5.0, v_x=0.0, v_y=0.0, dt=1.0, max_a=2.0)\n",
        "    sensor = LIDAR(fov=360, r_max=10.0, B=8)\n",
        "    grid_map = LidarGridMapVec(\n",
        "        x_min=area[0], x_max=area[1],\n",
        "        y_min=area[2], y_max=area[3],\n",
        "        quantization_level=3,\n",
        "    )\n",
        "    bmdp = BeliefMDP_n_Mapping(\n",
        "        n=3,\n",
        "        motion_model=motion_model,\n",
        "        measurement_model=sensor,\n",
        "        obstacles=obstacles,\n",
        "        _map=grid_map,\n",
        "    )\n",
        "    \n",
        "    # Set known pose and seed map\n",
        "    known_pose = np.array([5.0, 5.0, 0.0, 0.0])\n",
        "    bmdp.known_pose = known_pose\n",
        "    bmdp.map.seed_from_obstacles(obstacles)\n",
        "\n",
        "    len_M = bmdp.len_M\n",
        "\n",
        "    # Create uniform belief (1D for mapping)\n",
        "    π_0 = random.dirichlet(np.ones(len_M)).flatten()\n",
        "    π_0 = π_0 / π_0.sum()\n",
        "\n",
        "    x_current = np.array([5.0, 5.0, 0.0, 0.0])\n",
        "    u = np.array([0.5, 0.0])\n",
        "    x_next = motion_model.f_bar(x_current, u)\n",
        "    B = sensor.B\n",
        "    r_max = sensor.r_max\n",
        "\n",
        "    print(f\"\\n=== Testing F/H/η_n consistency (Mapping) ===\")\n",
        "\n",
        "    # Test F consistency: posterior should be valid\n",
        "    y_test = random.uniform(0.1, r_max, B)\n",
        "    π_post = bmdp.F_batch(π_0, x_next, y_test[np.newaxis, :])[0]\n",
        "\n",
        "    assert np.all(π_post >= 0), \"Posterior must be non-negative\"\n",
        "    assert np.abs(π_post.sum() - 1.0) < 1e-10, \"Posterior must be normalized\"\n",
        "    print(\"✓ F produces valid normalized beliefs\")\n",
        "\n",
        "    # Test H normalization\n",
        "    H_vals = bmdp.H_vectorized_batch(y_test[np.newaxis, :], π_0, x_next)\n",
        "    print(f\"✓ H computation successful: H(y|π,x_next) = {float(H_vals[0]):.6e}\")\n",
        "\n",
        "    print(\"✓ F, H, η_n are mathematically consistent\")\n",
        "\n",
        "test_f_h_eta_consistency()\n"
      ]
